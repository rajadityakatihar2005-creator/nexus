        <section id="hero">
            <div class="hero-content">
                <div class="badge">NOVEMBER 2026 • NATIONAL SYMPOSIUM</div>
                <h1>BEYOND THE SINGULARITY</h1>
                <p>Enter the ultimate 3D digital frontier. Compete in autonomous robotics, quantum algorithms, and spatial computing challenges with innovators nationwide.</p>
                <a href="#register" class="btn">INITIALIZE ACCESS</a>
            </div>
        </section>

        <!-- Section 2: Events -->
        <section id="events">
            <div class="glass-panel">
