        <!-- Section 3: Workshops -->
        <section id="workshops">
            <div class="glass-panel">
                <h2>FUTURE TECH LABS</h2>
                <div class="event-item">
                    <h3>QUANTUM COMPUTING 101</h3>
                    <span>Hands-on qubit simulation and cryptographic protocols.</span>
                </div>
                <div class="event-item">
                    <h3>WEBGL & SHADER ART</h3>
                    <span>Build real-time 3D GPU graphics for the modern web.</span>
                </div>
                <div class="event-item">
                    <h3>BRAIN-COMPUTER INTERFACES</h3>
                    <span>Live EEG signal processing and prosthetic control demos.</span>
                </div>
            </div>
        </section>

        <!-- Section 4: Register -->
        <section id="register">
            <div class="cta-box">
                <div class="badge">LIMITED SLOTS AVAILABLE</div>
                <h2>CLAIM YOUR DIGITAL PASS</h2>
                <p>Unlock full access to all 30+ competitions, keynote sessions, pro-nights, and maker spaces.</p>
                <button class="btn" onclick="triggerOverdrive()">REGISTER NOW</button>
            </div>
        </section>
    </main>

